# Copy to .env on the Pi and fill in. .env is never committed.

# From Cloudflare: Zero Trust > Networks > Tunnels > your tunnel > the token in the install command.
CLOUDFLARE_TUNNEL_TOKEN=

# Which published images to run: "latest", or a commit's "sha-1a2b3c4" tag to
# go back to an earlier version.
LA_BODITA_TAG=latest

# Only for building the images yourself with docker-compose.build.yml: the
# address guests open, without a trailing slash. The published images use the
# PUBLIC_URL repository variable on GitHub instead.
PUBLIC_URL=https://labodita.gerardoyvicky.com
